# ── AI Extraction/Marking service — environment configuration ──────────────
# Copy to .env and fill in. The .env file is gitignored.

# ── GCP / Vertex AI (required) ─────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=asia-south1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Only needed for the google.generativeai SDK path (list_models.py diagnostics):
GOOGLE_API_KEY=

# Model selection
PRIMARY_MODEL=gemini-2.5-flash
FALLBACK_MODEL=gemini-1.5-flash
MODEL_MAX_RETRIES=3

# ── Authentication (REQUIRED in production) ────────────────────────────────
# Comma-separated accepted API keys; clients send one as the X-API-Key header.
# If empty, auth is DISABLED (a warning is logged) — never ship empty.
SERVICE_API_KEY=

# ── Uploads ────────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=10485760        # 10 MB
MAX_BATCH_IMAGES=20
MAX_FORM_FIELD_LEN=200

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Empty = same-origin only. Never use "*".
CORS_ALLOWED_ORIGINS=

# ── Token usage logging ────────────────────────────────────────────────────
# Directory for CSV usage logs; leave empty for ./logs beside token_logger.py.
# Point this OUTSIDE the web-served root in production.
TOKEN_LOG_DIR=

# ── Server ─────────────────────────────────────────────────────────────────
PORT=8000
